<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RemoteShouter.Views.AdminPasswordWindow"
        Title="管理员确认"
        Width="440"
        Height="300"
        MinWidth="380"
        MinHeight="260"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Border Padding="28"
          Background="#FFFFFF">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
      <TextBlock x:Name="OperationText"
                 Grid.Row="0"
                 FontSize="22"
                 FontWeight="SemiBold"
                 Foreground="#242424" />
      <TextBlock Grid.Row="1"
                 Margin="0,14,0,0"
                 Text="请输入任意启用的管理员账户密码以继续。"
                 TextWrapping="Wrap"
                 Foreground="#616161" />
      <TextBox x:Name="PasswordBox"
               Grid.Row="2"
               Margin="0,14,0,0"
               PasswordChar="●"
               Watermark="管理员密码"
               KeyDown="PasswordBox_OnKeyDown" />
      <TextBlock x:Name="ErrorText"
                 Grid.Row="3"
                 IsVisible="False"
                 TextWrapping="Wrap"
                 Foreground="#B10E1C" />
      <StackPanel Grid.Row="4"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8">
        <Button Content="取消"
                Click="CancelButton_OnClick" />
        <Button Classes="accent"
                Content="确认"
                Click="ConfirmButton_OnClick" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
