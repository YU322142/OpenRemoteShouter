<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RemoteShouter.Views.ShoutWindow"
        Title="OpenRemoteShouter"
        Width="1280"
        Height="720"
        MinWidth="640"
        MinHeight="420"
        FontFamily="Microsoft YaHei, PingFang SC, Noto Sans CJK SC, WenQuanYi Micro Hei, sans-serif"
        WindowStartupLocation="Manual"
        SystemDecorations="None"
        CanResize="False">
  <Grid x:Name="RootGrid" RowDefinitions="Auto,*">
    <Border x:Name="AccentBand"
            Grid.Row="0"
            Height="210"
            Padding="56,38,120,38"
            Background="#0E7490">
      <StackPanel VerticalAlignment="Center" Spacing="8">
        <TextBlock x:Name="EyebrowText"
                   Text="OpenRemoteShouter"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Opacity="0.82" />
        <TextBlock x:Name="TitleText"
                   Text="发送了一条消息"
                   FontSize="46"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis"
                   RenderTransformOrigin="50%,50%">
          <TextBlock.RenderTransform>
            <TranslateTransform />
          </TextBlock.RenderTransform>
        </TextBlock>
      </StackPanel>
    </Border>

    <Border x:Name="MessageFrame"
            Grid.Row="1"
            Margin="48,-28,48,48"
            Padding="56"
            CornerRadius="16"
            BorderThickness="1">
      <ScrollViewer x:Name="MessageScrollViewer"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="MessageViewport">
          <TextBlock x:Name="MessageText"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     RenderTransformOrigin="50%,0%">
            <TextBlock.RenderTransform>
              <TranslateTransform />
            </TextBlock.RenderTransform>
          </TextBlock>
        </Grid>
      </ScrollViewer>
    </Border>

    <Button x:Name="CloseButton"
            Grid.RowSpan="2"
            Width="56"
            Height="56"
            Margin="28"
            Padding="0"
            CornerRadius="28"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Click="CloseButton_OnClick">
      <TextBlock Text="&#x00D7;"
                 FontSize="34"
                 FontWeight="Light"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />
    </Button>

    <!-- Kept hidden for compatibility with the duration timer API. -->
    <TextBlock x:Name="CountdownText" IsVisible="False" />
  </Grid>
</Window>
