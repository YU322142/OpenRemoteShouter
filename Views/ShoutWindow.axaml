<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RemoteShouter.Views.ShoutWindow"
        Title="OpenRemoteShouter"
        Width="1280"
        Height="720"
        MinWidth="640"
        MinHeight="420"
        FontFamily="Microsoft YaHei, PingFang SC, Noto Sans CJK SC, WenQuanYi Micro Hei, sans-serif"
        WindowStartupLocation="Manual"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="Transparent"
        Background="Transparent"
        SystemDecorations="None"
        CanResize="False">
  <Grid x:Name="RootGrid" RowDefinitions="Auto,*">
    <Border x:Name="AccentBand"
            Grid.Row="0"
            Height="210"
            Padding="56,38,120,38"
            Background="#0E7490"
            ZIndex="2"
            RenderTransformOrigin="50%,0%">
      <StackPanel VerticalAlignment="Center" Spacing="8">
        <TextBlock x:Name="EyebrowText"
                   Text="OpenRemoteShouter"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Opacity="0.82" />
        <TextBlock x:Name="TitleText"
                   Text="发送了一条消息"
                   FontSize="46"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Border>

    <Border x:Name="BodySurface"
            Grid.Row="1"
            Background="#EAF8FA"
            ZIndex="1"
            RenderTransformOrigin="50%,0%">
      <Border x:Name="MessageFrame"
              Margin="48,-28,48,48"
              Padding="56"
              CornerRadius="16"
              BorderThickness="1"
              RenderTransformOrigin="50%,0%">
        <ScrollViewer x:Name="MessageScrollViewer"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">
          <Grid x:Name="MessageViewport">
            <TextBlock x:Name="MessageText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
          </Grid>
        </ScrollViewer>
      </Border>
    </Border>

    <Button x:Name="CloseButton"
            Grid.RowSpan="2"
            Width="56"
            Height="56"
            Margin="28"
            Padding="0"
            CornerRadius="28"
            ZIndex="3"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Click="CloseButton_OnClick"
            Content="×"
            FontSize="28"
            FontWeight="Regular" />

    <!-- Kept hidden for compatibility with the duration timer API. -->
    <TextBlock x:Name="CountdownText" IsVisible="False" />
  </Grid>
</Window>
